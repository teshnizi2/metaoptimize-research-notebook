{
  "framework": "vite",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/learn-files/:path*",
      "destination": "/api/learn-file?p=:path*"
    },
    {
      "source": "/((?!assets/|data/|source/|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/learn-files/pdf/:file",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; object-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
        }
      ]
    }
  ]
}
