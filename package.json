{
  "name": "metaoptimize-research-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run copy:check && node scripts/sync-journal.mjs && node scripts/sync-artifact-dates.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "copy:check": "tsx scripts/check-experiment-copy.ts",
    "log": "node scripts/journal.mjs",
    "deploy": "npm run test && node scripts/sync-journal.mjs && node scripts/sync-artifact-dates.mjs && python3 scripts/package_notebook.py --verify && npm run build && vercel --prod --archive=tgz",
    "dates:check": "node scripts/sync-artifact-dates.mjs --check",
    "dates:refresh": "python3 scripts/export_artifact_dates.py"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.46.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
